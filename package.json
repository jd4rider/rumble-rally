{
  "name": "rumble-rally",
  "private": true,
  "version": "0.1.2",
  "description": "A physics driving puzzle: steer your car over ramps, gaps and crates to the flag.",
  "author": "jd4rider",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test src/game.test.js",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win nsis --x64",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.jd4rider.rumble-rally",
    "productName": "Rumble Rally",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.puzzle-games",
      "icon": "build/icon.icns",
      "artifactName": "Rumble-Rally-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Rumble Rally ${version}"
    },
    "win": {
      "icon": "build/icon-1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Rumble-Rally-win-setup.${ext}"
    },
    "linux": {
      "category": "Game",
      "icon": "build/icon-1024.png",
      "artifactName": "Rumble-Rally-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ]
    }
  }
}
